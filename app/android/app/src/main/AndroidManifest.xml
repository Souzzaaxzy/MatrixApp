<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+ runtime permission for native notifications. Asked
         once at startup; the app keeps working if the user denies it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Microphone access for the voice-message recorder. Runtime-granted
         (never auto-granted); the recorder asks before the first capture. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!--
      usesCleartextTraffic allows plain-HTTP API hosts (e.g. a Pterodactyl
      server without TLS yet). Remove it once the API is served over HTTPS.
    -->
    <application
        android:label="MATRIX"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <!--
          launchMode="singleTop": a share that arrives while MATRIX is already
          open is delivered to the EXISTING instance via onNewIntent — no
          second window/task is created.

          NOTE: there is deliberately no android:taskAffinity here. Setting it
          to "" (which this project used to do to mitigate StrandHogg) gives
          the launcher activity NO affinity, so it can never join the app's
          default task — every launch happens into a brand-new empty task.
          Combined with the share flow this produced the "MatrixApp →
          MatrixApp → …" cascade of instances.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
              Receber figuritas por compartilhamento nativo do Android.

              O WhatsApp NÃO compartilha um pacote de figurinhas como várias
              imagens: ele envia UM arquivo `.wastickers` (um ZIP com os
              .webp/.png + título/autor), normalmente com MIME
              application/vnd.wastickers, application/octet-stream,
              application/zip ou application/*. Por isso os filtros abaixo
              cobrem `image/*` (figurinha única) E `application/*` /
              `*/*` (pacote). O conteúdo real (bytes) é SEMPRE validado no
              app antes de importar — o filtro apenas torna o MATRIX um
              destino possível.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="application/*"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="application/*"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
            <!--
              "Abrir com" um arquivo .wastickers salvo no gerenciador de
              arquivos (mesmo fluxo de importação, sem ACTION_SEND). O filtro
              é restrito aos MIME de pacote para NÃO reivindicar arquivos
              genéricos (um `application/octet-stream` genérico seria oferecido
              para qualquer binário).
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/vnd.wastickers"/>
                <data android:mimeType="application/x-wastickers"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
