# ──────────────────────────────────────────────
# MATRIX monorepo root .gitignore
# ──────────────────────────────────────────────

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# ── Flutter app (app/) ─────────────────────────
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/build/

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Android Studio build artifacts
/android/app/debug
/android/app/profile
/android/app/release

# Flutter local config (never commit)
app/android/local.properties

# ── Backend server (server/) ───────────────────
node_modules/
dist/
coverage/
*.tsbuildinfo

# Environment files — NEVER commit secrets
.env
.env.*
!.env.example

# Local file storage for uploads (dev only)
server/uploads/

# Prisma generated client (regenerated on install/build)
server/src/generated/

# ── General ───────────────────────────────────
.vscode/
